# Arcive Mainnet Environment Configuration
# Target Network: Arc Mainnet (Chain ID 5042)
NEXT_PUBLIC_CHAIN_ID=5042
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_EXPLORER_URL=https://explorer.arc.io

# Deployed Contract Addresses (Populated automatically after 'npm run deploy:mainnet')
NEXT_PUBLIC_ARCIVE_NFT_CONTRACT=
NEXT_PUBLIC_ARCIVE_CONTRACT=

# Optional: Public Wallet Address for Gas Estimation & Status Checking
# (Safe to include public address; NEVER put your private key in .env or .env.local!)
# DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000
